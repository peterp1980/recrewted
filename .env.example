# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, bypasses RLS:
SUPABASE_SERVICE_ROLE_KEY=

# Database tests (npm run test:db) – a local Postgres where the test user may create databases
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
