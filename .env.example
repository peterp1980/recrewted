# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, bypasses RLS:
SUPABASE_SERVICE_ROLE_KEY=

# Database tests (npm run test:db) – a local Postgres where the test user may create databases
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres

# Mail (SMTP, EU provider). Without SMTP_HOST mails stay queued in mail_outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="recrewted <bewerbung@recrewted.de>"
MAIL_REPLY_TO=
# Protects /api/cron/* (Vercel sends it automatically as Bearer token)
CRON_SECRET=
# Signs the 24-hour links for data subject requests (any long random string)
DATA_REQUEST_SECRET=
# Conversions (F12) – leave empty until the accounts are connected
META_PIXEL_ID=
META_CAPI_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CONVERSION_LEAD=
LINKEDIN_CONVERSION_QUALIFIED=
LINKEDIN_CONVERSION_HIRED=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_ACTION_LEAD=
GOOGLE_ADS_ACTION_QUALIFIED=
GOOGLE_ADS_ACTION_HIRED=
